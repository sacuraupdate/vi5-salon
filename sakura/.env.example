# 設定手順の詳しい説明は docs/env-setup.md を見てください。
# このファイルをコピーして .env.local を作り、そこに値を入れます。
# .env.local は GitHub に保存されません。

# ---- 公開してよい値（ブラウザにも渡る。秘密の鍵は絶対にここに入れない） ----

# サイトのURL。canonical / hreflang / OG / 決済後の戻り先に使う。末尾の / は不要
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# お客様に表示する問い合わせ先。未設定なら問い合わせページに「準備中」と出る
NEXT_PUBLIC_SUPPORT_EMAIL=

# データ取得先。Phase 1 は mock のみ
NEXT_PUBLIC_DATA_SOURCE=mock

# ---- 秘密の値（サーバーだけが読む。絶対に公開しない） ----

# Supabase（データベース）
# Project Settings → Data API → Project URL
SUPABASE_URL=
# Project Settings → API Keys → service_role（anon ではない）
SUPABASE_SERVICE_ROLE_KEY=

# Stripe（決済）
# 開発者 → APIキー → シークレットキー（sk_ で始まる。pk_ ではない）
STRIPE_SECRET_KEY=
# 開発者 → Webhook → エンドポイントの詳細 → 署名シークレット（whsec_ で始まる）
# これが無いと、支払われても受講権限が付きません
STRIPE_WEBHOOK_SECRET=

# Resend（メール送信）
# API Keys → Create API Key（re_ で始まる。作成直後しか表示されない）
RESEND_API_KEY=
# 送信元。Resend で認証済みのドメインのアドレスにすること
EMAIL_FROM=
# 問い合わせフォームの届き先。未設定なら NEXT_PUBLIC_SUPPORT_EMAIL を使う
CONTACT_TO_EMAIL=

# ---- 開発・確認環境専用。本番では絶対に設定しないこと ----

# 管理画面（/admin）を動かす。認証が未実装のため、本番では管理画面を開けなくする
ADMIN_DEMO_MODE=true
# 購入者向け画面（/mypage・/learn）を確認用セッションで開けるようにする
SITE_DEMO_MODE=true
