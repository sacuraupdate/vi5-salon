# データ取得先。Phase 1 は mock のみ。Phase 2 で supabase を追加する。
NEXT_PUBLIC_DATA_SOURCE=mock

# 公開URL。canonical / hreflang / OG の絶対URLに使う。
# ドメインが決まったらここを設定する（末尾のスラッシュは不要）。
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 問い合わせ用メールアドレス。未設定なら問い合わせページに「準備中」と表示される。
NEXT_PUBLIC_SUPPORT_EMAIL=

# ---- 以下は開発・確認環境専用。本番では絶対に設定しないこと ----
# 管理画面（/admin）を動かす。認証が未実装のため、本番では管理画面を開けなくする。
ADMIN_DEMO_MODE=true
# 購入者向け画面（/mypage・/learn）を確認用セッションで開けるようにする。
# 未設定なら本番と同じく、誰もログインできない。
SITE_DEMO_MODE=true
